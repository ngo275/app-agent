# Local-only defaults. Copy to .env; never commit real credentials.
# Generate your own value: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# A new local PostgreSQL database. Set your own matching password.
DATABASE_URL="postgresql://appagent:replace-with-your-local-password@localhost:5432/appagent?schema=public"

# Needed for AI features; calls incur charges in your own OpenAI account.
OPENAI_API_KEY=

# Needed for keyword/search caching (Upstash REST, not a Redis TCP URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local use has no subscription gate or Stripe endpoints.
NEXT_PUBLIC_FREE_PLAN_ENABLED=true

# Optional Google login. Development email login uses the server terminal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional production-mode email login, using your own verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional analytics. Leave blank for local use.
NEXT_PUBLIC_POSTHOG_KEY=
JITSU_HOST=
JITSU_WRITE_KEY=

# Legacy billing integrations for forks only; not needed for local use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
